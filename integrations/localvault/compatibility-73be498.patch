+'use strict';
+// Match the memory center's normalized json.dumps(ensure_ascii=False,sort_keys=True).
+function serialized(value) {
+  if (Array.isArray(value)) return '[' + value.map(serialized).join(', ') + ']';
+  if (value && typeof value === 'object') return '{' + Object.keys(value).sort()
+    .map(k => JSON.stringify(k) + ': ' + serialized(value[k])).join(', ') + '}';
+  return JSON.stringify(value);
+}
+const cpLength = value => Array.from(value).length;
+function normalizedMessages(messages) {
+  return messages.map(m => {
+    const out = { id: m.id, role: m.role, text: m.text };
+    for (const key of ['source_title', 'created_at']) if (m[key] != null) out[key] = m[key];
+    return out;
+  });
+}
+const messagesLength = messages => cpLength(serialized(normalizedMessages(messages)));
+module.exports = { cpLength, messagesLength };
